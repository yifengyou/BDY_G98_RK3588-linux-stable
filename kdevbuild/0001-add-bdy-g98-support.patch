From 407fef07f2ceeeebeebf9d157c0072e5452a1994 Mon Sep 17 00:00:00 2001
From: yifengyou <842056007@qq.com>
Date: Fri, 2 Oct 2026 00:56:41 +0800
Subject: [PATCH] add bdy g98 support

Signed-off-by: yifengyou <842056007@qq.com>

diff --git a/.gitignore b/.gitignore
index 9875120ea7bd..7c9b175e4bf3 100644
--- a/.gitignore
+++ b/.gitignore
@@ -194,3 +194,8 @@ sphinx_*/
 
 # bc language scripts (not LLVM bitcode)
 !kernel/time/timeconst.bc
+/kernel-devel/
+/kernel-headers/
+/kos-debug/
+/kos/
+/release/
diff --git a/arch/arm64/boot/dts/rockchip/Makefile b/arch/arm64/boot/dts/rockchip/Makefile
index e7936a21c118..3cdccfbd18ea 100644
--- a/arch/arm64/boot/dts/rockchip/Makefile
+++ b/arch/arm64/boot/dts/rockchip/Makefile
@@ -1,4 +1,5 @@
 # SPDX-License-Identifier: GPL-2.0
+dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588-bdy-g98.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += px30-cobra-ltk050h3146w-a2.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += px30-cobra-ltk050h3146w.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += px30-cobra-ltk050h3148w.dtb
